{
  "name": "@local/dsh-ketcher",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "keywords": ["dsh", "dsh-plugin", "deepseek-harness", "ketcher", "chemistry", "smiles", "molecule", "editor"],
  "description": "Ketcher 化学分子式编辑器：在 DSH 右侧边栏里绘制/编辑分子结构并复制 SMILES/molfile，并让 Agent 能校验 SMILES、估算分子式。",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./market/*": "./market/*"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "market/*.json",
    "market/icon.svg",
    "vendor/**"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  }
}
